# ---------------------------------------------------------------------------
# QR Office · configuración
# Copia este archivo como ".env" y ajusta los valores. Todas las variables
# son opcionales: si no se definen se usa el valor indicado como "defecto".
# ---------------------------------------------------------------------------

# Puerto en el que escucha el servidor. (defecto: 3000)
PORT=3000

# Interfaz de red en la que escucha el servidor. (defecto: 0.0.0.0)
#   0.0.0.0   -> accesible desde otros dispositivos de la red local (móviles).
#   127.0.0.1 -> sólo desde este equipo (los QR apuntarán a localhost).
HOST=0.0.0.0

# URL a la que apuntarán los códigos QR. (defecto: vacío)
# Vacío = se detecta automáticamente la IP de este equipo en la red local,
# por ejemplo http://192.168.1.20:3000.
# Defínela si publicas la aplicación en un dominio o un túnel, por ejemplo:
#   PUBLIC_BASE_URL=https://qr.midominio.com
PUBLIC_BASE_URL=

# Tamaño máximo de cada documento, en megabytes (1-1024). (defecto: 25)
MAX_FILE_SIZE_MB=25

# Horas que se conserva cada documento antes de borrarse (0 = nunca). (defecto: 168 = 7 días)
FILE_TTL_HOURS=168

# Carpeta donde se guardan los documentos y el índice. (defecto: storage)
STORAGE_DIR=storage

# Número de proxies inversos delante del servidor (nginx, Caddy, túnel…). (defecto: 0)
# Necesario para que la limitación de peticiones vea la IP real del cliente.
TRUST_PROXY=0

# Máximo de subidas por IP cada 15 minutos. (defecto: 30)
RATE_LIMIT_UPLOADS=30

# Máximo de imágenes QR generadas por IP cada 15 minutos. (defecto: 600)
RATE_LIMIT_QR=600

# Registrar cada petición en la consola (true/false). (defecto: true)
LOG_REQUESTS=true
